{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Personal News edition v1",
  "description": "Cross-edition IDs, dates, recency and derived indexes are additionally validated by tools/news.py.",
  "type": "object",
  "required": [
    "version",
    "date",
    "generated_at",
    "kind",
    "title",
    "summary",
    "items"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "kind": {
      "enum": [
        "daily",
        "bootstrap"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 700
    },
    "note": {
      "type": "string",
      "minLength": 1
    },
    "items": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "id",
          "event_id",
          "category",
          "status",
          "title",
          "summary",
          "why_you_care",
          "published_date",
          "event_date",
          "verified_at",
          "featured",
          "tags",
          "sources",
          "image"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9-]+$"
          },
          "event_id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "category": {
            "enum": [
              "ai",
              "agents",
              "work",
              "gamedev",
              "gaming",
              "devices"
            ]
          },
          "status": {
            "enum": [
              "NEW",
              "UPDATE"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "why_you_care": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "published_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "event_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "published_at": {
            "type": "string",
            "format": "date-time"
          },
          "verified_at": {
            "type": "string",
            "format": "date-time"
          },
          "featured": {
            "type": "boolean"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "name",
                "type",
                "url"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "type": {
                  "enum": [
                    "official",
                    "research",
                    "reputable",
                    "community"
                  ]
                },
                "url": {
                  "type": "string",
                  "pattern": "^https://"
                }
              },
              "additionalProperties": false
            }
          },
          "image": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "url",
                  "alt",
                  "credit",
                  "source_url"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "pattern": "^https://"
                  },
                  "alt": {
                    "type": "string",
                    "minLength": 1
                  },
                  "credit": {
                    "type": "string",
                    "minLength": 1
                  },
                  "source_url": {
                    "type": "string",
                    "pattern": "^https://"
                  },
                  "verification": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false
              }
            ]
          },
          "delta": {
            "type": "string",
            "minLength": 1
          },
          "recency_reason": {
            "type": "string",
            "minLength": 1
          },
          "previous": {
            "type": "object",
            "required": [
              "date",
              "id"
            ],
            "properties": {
              "date": {
                "type": "string",
                "format": "date"
              },
              "id": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "UPDATE"
                }
              }
            },
            "then": {
              "required": [
                "delta",
                "previous"
              ]
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "edition_id": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-initial$",
      "description": "Only for the preserved same-day initial edition. Ordinary daily editions omit it."
    }
  },
  "additionalProperties": false
}
