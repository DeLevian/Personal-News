+  "version": 1,
+  "item_id": "2026-09-27-gpt-6-sol-luna-launch",
+  "language": "it",
+  "editorial_mode": "original",
+  "source_item_hash": "993052eff6bd2b042274cf6b32e4be2921be4a7eb4583e182c80ea5a99077c97",
+  "written_at": "2026-09-27T17:52:39+00:00",
